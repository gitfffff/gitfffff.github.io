---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="写作">
	<section class="card-base px-6 py-6 md:px-8 md:py-8">
		<div class="mb-6">
			<h1 class="text-2xl font-bold text-90 mb-2">写作</h1>
			<p class="text-50 leading-7">
				填写文章后会直接提交到 GitHub 仓库，GitHub Pages 会自动重新发布。
			</p>
		</div>

		<form id="post-form" class="space-y-5">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<label class="block">
					<span class="block text-sm font-medium text-75 mb-2">GitHub Token</span>
					<input
						id="token"
						type="password"
						autocomplete="off"
						class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
						placeholder="只保存在当前浏览器"
					/>
				</label>
				<label class="block">
					<span class="block text-sm font-medium text-75 mb-2">文件名</span>
					<input
						id="slug"
						type="text"
						class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
						placeholder="my-new-post"
					/>
				</label>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<label class="block">
					<span class="block text-sm font-medium text-75 mb-2">标题</span>
					<input
						id="title"
						type="text"
						class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
						placeholder="文章标题"
					/>
				</label>
				<label class="block">
					<span class="block text-sm font-medium text-75 mb-2">日期</span>
					<input
						id="published"
						type="date"
						class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
					/>
				</label>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<label class="block">
					<span class="block text-sm font-medium text-75 mb-2">分类</span>
					<input
						id="category"
						type="text"
						class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
						placeholder="随笔"
					/>
				</label>
				<label class="block">
					<span class="block text-sm font-medium text-75 mb-2">标签</span>
					<input
						id="tags"
						type="text"
						class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
						placeholder="博客, 记录"
					/>
				</label>
			</div>

			<label class="block">
				<span class="block text-sm font-medium text-75 mb-2">摘要</span>
				<input
					id="description"
					type="text"
					class="w-full h-11 rounded-lg bg-[var(--btn-regular-bg)] px-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
					placeholder="一句话摘要"
				/>
			</label>

			<label class="block">
				<span class="block text-sm font-medium text-75 mb-2">正文 Markdown</span>
				<textarea
					id="body"
					class="w-full min-h-[28rem] rounded-lg bg-[var(--btn-regular-bg)] p-4 font-mono text-sm leading-7 outline-none focus:ring-2 focus:ring-[var(--primary)]"
					placeholder="这里开始写正文"
				></textarea>
			</label>

			<div class="flex flex-wrap gap-3 items-center">
				<button
					id="publish"
					type="submit"
					class="btn-regular rounded-lg h-11 px-5 font-bold active:scale-95"
				>
					发布文章
				</button>
				<button
					id="clear-token"
					type="button"
					class="btn-plain rounded-lg h-11 px-4 font-medium active:scale-95"
				>
					清除 Token
				</button>
				<span id="status" class="text-sm text-50"></span>
			</div>
		</form>

		<div class="mt-8 border-t border-black/10 dark:border-white/10 pt-5 text-sm text-50 leading-7">
			<p>Token 需要仓库 Contents 读写权限。发布成功后通常等待 1 到 2 分钟即可在首页看到文章。</p>
		</div>
	</section>
</MainGridLayout>

<script>
// @ts-nocheck
const owner = "gitfffff";
const repo = "gitfffff.github.io";
const branch = "main";
const tokenKey = "blog-admin-github-token";

const $ = (id) => document.getElementById(id);

function today() {
	const date = new Date();
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, "0");
	const day = String(date.getDate()).padStart(2, "0");
	return `${year}-${month}-${day}`;
}

function slugify(value) {
	return value
		.toLowerCase()
		.trim()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "");
}

function quoteYaml(value) {
	return JSON.stringify(String(value || ""));
}

function toBase64(content) {
	const bytes = new TextEncoder().encode(content);
	let binary = "";
	for (const byte of bytes) {
		binary += String.fromCharCode(byte);
	}
	return btoa(binary);
}

function setStatus(message, isError = false) {
	const status = $("status");
	status.textContent = message;
	status.classList.toggle("text-red-500", isError);
	status.classList.toggle("text-[var(--primary)]", !isError);
}

function buildMarkdown() {
	const title = $("title").value.trim();
	const fallbackSlug = slugify(title) || `post-${Date.now()}`;
	const slug = slugify($("slug").value) || fallbackSlug;
	const tags = $("tags").value
		.split(/[,，]/)
		.map((tag) => tag.trim())
		.filter(Boolean);
	const body = $("body").value.trim();

	if (!title) throw new Error("请填写标题");
	if (!body) throw new Error("请填写正文");

	const markdown = `---
title: ${quoteYaml(title)}
published: ${$("published").value || today()}
description: ${quoteYaml($("description").value.trim())}
image: ""
tags: [${tags.map(quoteYaml).join(", ")}]
category: ${quoteYaml($("category").value.trim() || "随笔")}
draft: false
lang: zh_CN
---

${body}
`;

	return { slug, markdown };
}

async function publishPost(event) {
	event.preventDefault();

	const token = $("token").value.trim();
	if (!token) {
		setStatus("请先填写 GitHub Token", true);
		return;
	}

	localStorage.setItem(tokenKey, token);

	let post;
	try {
		post = buildMarkdown();
	} catch (error) {
		setStatus(error.message, true);
		return;
	}

	const path = `src/content/posts/${post.slug}.md`;
	const endpoint = `https://api.github.com/repos/${owner}/${repo}/contents/${path}`;
	const button = $("publish");

	button.disabled = true;
	setStatus("正在提交到 GitHub...");

	try {
		const response = await fetch(endpoint, {
			method: "PUT",
			headers: {
				Accept: "application/vnd.github+json",
				Authorization: `Bearer ${token}`,
				"X-GitHub-Api-Version": "2022-11-28",
			},
			body: JSON.stringify({
				message: `Add post: ${$("title").value.trim()}`,
				content: toBase64(post.markdown),
				branch,
			}),
		});

		const result = await response.json();
		if (!response.ok) {
			throw new Error(result.message || "提交失败");
		}

		setStatus(`发布成功：${path}`);
		$("post-form").reset();
		$("published").value = today();
		$("token").value = token;
	} catch (error) {
		setStatus(error.message, true);
	} finally {
		button.disabled = false;
	}
}

$("published").value = today();
$("token").value = localStorage.getItem(tokenKey) || "";
$("clear-token").addEventListener("click", () => {
	localStorage.removeItem(tokenKey);
	$("token").value = "";
	setStatus("Token 已清除");
});
$("post-form").addEventListener("submit", publishPost);
</script>
